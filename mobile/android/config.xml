<?xml version='1.0' encoding='utf-8'?>
<widget id="com.elTiempo.DirectorySources" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Directory_Sources</name>
    <description>Sample Apache Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <plugin name="cleafy-cordova-plugin" spec="file:../../pkg/PluginCleafy" />
    <platform name="android">
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:debuggable="true" xmlns:android="http://schemas.android.com/apk/res/android" />
        </edit-config>
    </platform>
</widget>
